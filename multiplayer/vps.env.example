# Copy file này thành multiplayer/.env.vps rồi điền giá trị thật.
# KHÔNG commit .env.vps.

# Backend đang chạy trên Vercel (hoặc domain riêng của bạn).
QBO_API_URL=https://quay-bar-online-server.vercel.app

# Phải TRÙNG với GAME_SERVER_SECRET trên Vercel.
GAME_SERVER_SECRET=change-me-to-the-same-secret-as-vercel

# IP/domain công khai của VPS (client dùng địa chỉ này để kết nối UDP).
# Để trống nếu muốn heartbeat tự lấy IP qua api.ipify.org.
PUBLIC_GAME_HOST=

# Cổng UDP của game server, phải mở trên firewall VPS.
GAME_PORT=3221

GAME_SERVER_NAME=The Chrome Lotus - VPS
GAME_SERVER_REGION=sin
