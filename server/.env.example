# QUẨY BAR ONLINE — Backend environment
# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# MySQL 8 (Prisma)
DATABASE_URL="mysql://qbo:qbo_dev_password@127.0.0.1:3306/quaybaronline"

# JWT access token signing secret — tối thiểu 32 ký tự, sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Bí mật chia sẻ giữa Next.js và Godot dedicated server để xác minh game ticket.
GAME_SERVER_SECRET="change-me-game-server-secret"

# Địa chỉ dedicated server mặc định (dùng khi chưa có server nào heartbeat).
GAME_SERVER_HOST="127.0.0.1"
GAME_SERVER_PORT="7000"

# Redis (tùy chọn, dùng cho rate limiting phân tán). Bỏ trống để dùng in-memory.
# REDIS_URL="redis://127.0.0.1:6379"

# Thời hạn token
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL_DAYS="30"
