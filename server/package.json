{
  "name": "quay-bar-online-server",
  "version": "0.1.0",
  "private": true,
  "description": "QUẨY BAR ONLINE — Next.js App Router backend (Auth, Rooms, Friends, Inventory, Reports, Game tickets)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "next": "16.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
